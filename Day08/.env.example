# .env.example 을 같은 폴더의 .env 로 복사한 뒤 자신의 키를 채운다.
# .env 는 배포하거나 커밋하지 않는다. 셸 환경변수가 .env 보다 우선한다.

# ── 주모델 ─────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Injection 분류기 (강사 RunPod vLLM, OpenAI 호환 endpoint) ─────
# 2026-09-16 수업용 Pod 주소. Pod 를 내리면 죽는다. 다시 띄우면 scripts/runpod_guards.sh env 로 새 주소를 받는다.
GUARD_INJECTION_URL=https://fnsvptr6xne078-8000.proxy.runpod.net/v1
GUARD_INJECTION_API_KEY=EMPTY
# kanana  → kakaocorp/kanana-safeguard-prompt-2.1b (<SAFE>/<UNSAFE-A1>/<UNSAFE-A2> 토큰). 문서형 Injection 을 SGuard 보다 잘 잡았다.
# sguard  → SamsungSDS-Research/SGuard-JailbreakFilter-2B-v1 (safe/unsafe 토큰 logprob)
GUARD_INJECTION_KIND=kanana
GUARD_INJECTION_MODEL=kakaocorp/kanana-safeguard-prompt-2.1b
# 08 비교용. 두 Pod 를 모두 띄웠을 때 각각의 주소.
GUARD_SGUARD_URL=https://gzwx0gfkqtvme2-8000.proxy.runpod.net/v1
GUARD_KANANA_URL=https://fnsvptr6xne078-8000.proxy.runpod.net/v1
# OpenRouter 의 Guard 모델(gpt-oss-safeguard-20b, nemotron-3.5-content-safety, llama-guard-4-12b)은
# OPENROUTER_API_KEY 로 호출한다. 별도 설정이 없다.

# ── PII 탐지기 (로컬 CPU) ───────────────────────────────────────
# trust_remote_code 모델이므로 커밋 해시를 고정한다. 비우면 main 을 받는다(권장하지 않음).
GUARD_PII_MODEL=LiquidAI/LFM2.5-Encoder-350M-PII-Detector
GUARD_PII_REVISION=b8c9cf3d2d6ae52501b35a27ba46f271449c9ce2
HF_HOME=.hf-cache
# Policy-Linter 도 trust_remote_code 모델이다 (07). 2026-09-15 snapshot 커밋.
GUARD_LINTER_REVISION=2a56cb94a7083a90263ea5270523ccc10e7ce8af
