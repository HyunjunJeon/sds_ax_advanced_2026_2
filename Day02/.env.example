# Copy to .env. The parent project's .env is also read, without being modified.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DAY02_MODEL=google/gemini-3.8-flash
DAY02_VISION_MODEL=google/gemini-3.8-flash
DAY02_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
DAY02_EMBEDDING_DIMENSION=4096
# 로컬 OpenViking 서버 포트. 여기만 바꾸면 서버 기동·문서 계정·검색이 모두 따라온다.
OPENVIKING_PORT=19350
# Optional remote server: both variables must be supplied together.
# OPENVIKING_URL=http://127.0.0.1:19350   # 원격 서버를 쓸 때만. 로컬은 OPENVIKING_PORT로 충분하다.
# OPENVIKING_API_KEY=
