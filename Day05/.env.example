# .env.example 을 같은 폴더의 .env 로 복사한 뒤 자신의 키를 채운다.
# .env 는 배포하거나 커밋하지 않는다. 셸 환경변수가 .env 보다 우선한다.

# ── 모델 (01~09 전부) ───────────────────────────────────────────
# Day04 와 같이 langchain-openrouter 가 OPENROUTER_API_KEY 를 읽는다.
OPENROUTER_API_KEY=
# 에이전트 본체가 쓰는 모델. OPENROUTER_MODEL 이 있으면 그게 우선한다.
OPENROUTER_MODEL=google/gemini-3.8-flash
# 판사만 다른 엔드포인트로 보낼 때가 아니면 비워 둔다 (SDK 기본값 사용).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPEVAL_JUDGE_MODEL=anthropic/claude-haiku-4.5
# 판사만 다른 엔드포인트·키를 쓸 때 (비워 두면 에이전트와 같은 OpenRouter 설정)
# DEEPEVAL_JUDGE_BASE_URL=
# DEEPEVAL_JUDGE_API_KEY=

# ── Langfuse ─────────────────────────────────────────────
# https://cloud.langfuse.com 가입 → 프로젝트 Settings → API Keys 에서 발급
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 가입할 때 고른 데이터 리전 주소 (EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com)
LANGFUSE_HOST=https://cloud.langfuse.com
# 이 실습에서 만든 트레이스에 붙는 환경 이름. 03·07·09 의 ENVIRONMENT 와 같게 둔다.
LANGFUSE_TRACING_ENVIRONMENT=day05

# ── DeepEval ─────────────────────────────────────────────────────
# 사용 통계 전송 끄기
DEEPEVAL_TELEMETRY_OPT_OUT=true
# 매 실행마다 찍히는 "No Confident AI API key found" 로그 끄기
# (Confident AI 클라우드는 이 실습에서 쓰지 않는다)
CONFIDENT_TRACE_VERBOSE=false
