# 기존 .env를 덮어쓰지 말고 필요한 값을 설정하세요. 실제 키를 코드에 넣지 않습니다.
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-3.8-flash
# OPENROUTER_MODEL/OPENROUTER_BASE_URL이 있으면 각각 위 모델/주소보다 우선합니다.
# 설정을 바꿨다면 스크립트를 다시 실행합니다. 셸 환경변수는 .env보다 우선합니다.

# backend="viking" 실험에서만 사용. 기본 실험(backend="local")은 로컬 코퍼스를 쓴다.
# 로컬 서버 포트. native_server.py의 서버 설정과 실습의 검색 주소가 이 값 하나를
# 함께 본다. 포트를 바꾸려면 여기만 고치면 된다.
OPENVIKING_PORT=1935
# 관리용 root 키가 아니라 문서 접근용 계정 키
OPENVIKING_API_KEY=
# 원격/강사 서버에 붙을 때만 지정한다. 주면 OPENVIKING_PORT보다 우선한다.
# OPENVIKING_URL=http://127.0.0.1:1935

# 08_web_enrichment.py: 웹 검색·본문 수집. 실제 키는 .env에만 둔다.
EXA_API_KEY=
